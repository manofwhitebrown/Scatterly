  "specials": { "ink": "#2b1d2e", "paper": "#fffdf4", "glow": "#fff2b8", "shade": "#3a2a4a" },
  "dayNight": { "morning": "#ffe9cf", "noon": "#ffffff", "dusk": "#ffc79a", "night": "#6f7bb8" },
  "rooms": {
    "entrance": { "wall": "plaster", "floor": "woodDark", "accent": "terracotta" },
    "living":   { "wall": "plaster", "floor": "woodWarm", "accent": "terracotta" },
    "kitchen":  { "wall": "butter",  "floor": "stone",    "accent": "sage" },
    "laundry":  { "wall": "stone",   "floor": "plaster",  "accent": "teal" },
    "bedroom":  { "wall": "sky",     "floor": "woodWarm", "accent": "rose" },
    "bathroom": { "wall": "teal",    "floor": "plaster",  "accent": "sky" },
