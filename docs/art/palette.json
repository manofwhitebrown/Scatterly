{
  "version": 1,
  "note": "Global palette, 64 colours max. Ramp order: [outline, shadow, base, light, highlight]. Source of truth for tools/render3d, tools/check-frames and src/art/manifest.ts.",
  "ramps": {
    "woodWarm":   ["#4a2e22", "#7a4a30", "#b0773f", "#d9a066", "#f2c98c"],
    "woodDark":   ["#2f1d1a", "#553529", "#7d523a", "#a0734f", "#c29a6e"],
    "plaster":    ["#8a7260", "#c2ab8e", "#e8d5b5", "#f6ead0", "#fff8e8"],
    "terracotta": ["#5e2a24", "#9a4634", "#c9684a", "#e58d68", "#f5b794"],
    "rose":       ["#6b2f3f", "#a5505e", "#d77f86", "#ecabab", "#f9d3cc"],
    "butter":     ["#7a5a1e", "#c0902f", "#eab94a", "#f6d777", "#fdeeaa"],
    "sage":       ["#2f4a3a", "#4f7a58", "#7eaa73", "#a8c98a", "#d0e3b0"],
    "teal":       ["#1f4a50", "#2f7478", "#4fa0a0", "#7cc4bb", "#b3e2d4"],
    "sky":        ["#2f4a6e", "#4f7ca8", "#7cabd0", "#a9d0e6", "#d6eef5"],
    "navy":       ["#1f2748", "#33447a", "#536ba8", "#7e95c9", "#aebfe6"],
    "plum":       ["#3c2850", "#5e4380", "#8a6aae", "#b296cf", "#d9c7ec"],
